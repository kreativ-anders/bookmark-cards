{
  "name": "kreativ-anders/bookmark-cards",
  "description": "Bookmark Cards – a Kirby CMS powered bookmark manager",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.6",
    "stripe/stripe-php": "^22.0"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "require-dev": {
    "pestphp/pest": "^5.3"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest"
  }
}
