{
    "name": "bookmark.cards",
    "version": "1.0.0",
    "description": "Bookmark.cards is a bookmarket collection tool in its simpliest form.",
    "author": "kreativ-anders | Manuel Steinberg",
    "devDependencies": {
        "@picocss/pico": "^2.0.6",
        "cypress": "^13.14.2",
        "esbuild": "^0.28.2"
    },
    "scripts": {
        "build": "node build.mjs",
        "watch": "node build.mjs --watch",
        "cy:open": "cypress open",
        "cy:test": "cypress run --spec 'cypress/e2e/register.cy.js,cypress/e2e/login.cy.js,cypress/e2e/delete.cy.js'",
        "generateBrandsCSS": "node ./assets/css/generateBrandsCSS.js",
        "minifyBrandsCSS": "esbuild assets/css/brands.css --minify --outfile=assets/css/brands.min.css"
    }
}
